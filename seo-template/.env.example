# Copy this file to .env and fill in real values. .env is gitignored.

# Black Forest Labs FLUX API key — DEFAULT image generator (cheap + high quality)
# Used by tools/generate-image-flux.ps1. ~$0.025/image for FLUX [dev], ~$0.04 for FLUX 1.1 [pro].
# Get one at https://docs.bfl.ml/
BFL_API_KEY=bfl_...

# OpenAI API key — FALLBACK image generator (gpt-image-1 via tools/generate-image.ps1)
# Kept for fallback / text-heavy infographics. ~$0.06–$0.25/image.
# Get one at https://platform.openai.com/api-keys
OpenAI_API_Key=sk-...
