# Copy to .env.local and fill in. .env* is gitignored.

# --- Anthropic (WAJIB) ---
# API key untuk Claude Agent SDK (pay-per-use).
# Dapatkan di https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# --- Lokasi folder client (opsional) ---
# Direktori yang memuat folder-folder client (seo-soltius, seo-gagas, ...).
# Default: folder induk dari article-studio (mis. .../Documents/artikel-claude).
# Boleh absolut. Gunakan path Windows dengan backslash atau forward-slash.
# CLIENTS_ROOT=C:/Users/Fajar Santoso/Documents/artikel-claude

# --- Override model per tier (opsional) ---
# Default mengikuti tier di frontmatter agent (.claude/agents/*.md).
# MODEL_OPUS=claude-opus-4-8
# MODEL_SONNET=claude-sonnet-4-6
# MODEL_HAIKU=claude-haiku-4-5

# --- Cetakan untuk client baru (opsional) ---
# Folder yang disalin saat membuat client baru dari UI.
# TEMPLATE_CLIENT=seo-template
