# Copy this file to .env and fill in real values. .env is gitignored.
#
# This pipeline generates NO images, so no image-generation API keys are needed.
# The slots below are optional upgrades for the editor's originality scan
# (tools/quality-check.ps1 falls back to its built-in heuristics if unset).

# Paid plagiarism API (optional)
PLAGIARISM_API_KEY=

# Paid AI-content-detector API (optional)
AI_DETECTOR_API_KEY=
